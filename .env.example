# ─── Application ────────────────────────────────────────────────────────────
POSTGRES_USER=upacip_user
POSTGRES_PASSWORD=change_me_strong_password

# Generate with: openssl rand -base64 64
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_SECRET

# PHI column encryption key — 32 bytes, base64 encoded
# Generate with: openssl rand -base64 32
PHI_ENCRYPTION_KEY=REPLACE_WITH_AES_256_KEY

# ─── Seq ────────────────────────────────────────────────────────────────────
# Generate hash: echo -n "your_password" | sha256sum or use Seq's CLI
SEQ_ADMIN_PASSWORD_HASH=REPLACE_WITH_SEQ_PASSWORD_HASH

# ─── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password

# ─── Twilio (SMS reminders) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_TOKEN
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ─── Google Calendar OAuth ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# ─── Microsoft Graph OAuth ───────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=REPLACE_WITH_MICROSOFT_CLIENT_ID
MICROSOFT_CLIENT_SECRET=REPLACE_WITH_MICROSOFT_CLIENT_SECRET
MICROSOFT_TENANT_ID=common
