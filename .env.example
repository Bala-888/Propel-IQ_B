# .env.example — UPACIP platform environment variables
# Copy this file to .env and fill in all REQUIRED values before running
# `docker compose up`.
#
# Generate a 32-byte base64 key:  openssl rand -base64 32
# Generate a 64-byte hex key:     openssl rand -hex 64

# ── Database ──────────────────────────────────────────────────────────────────

# REQUIRED: PostgreSQL database name
POSTGRES_DB=upacip

# REQUIRED: PostgreSQL superuser name
POSTGRES_USER=upacip_app

# REQUIRED: PostgreSQL superuser password — use a strong random value
POSTGRES_PASSWORD=

# REQUIRED: AES-256 master key used to encrypt PHI fields in the database.
# Must be a base64-encoded 32-byte (256-bit) value.
# The db service healthcheck will refuse to start if this variable is unset.
# Generate: openssl rand -base64 32
PHI_ENCRYPTION_KEY=

# ── Document storage ──────────────────────────────────────────────────────────

# REQUIRED: AES-256-GCM master key for encrypting uploaded clinical documents.
# Must be a base64-encoded 32-byte (256-bit) value.
# Generate: openssl rand -base64 32
DOCUMENT_MASTER_KEY=

# OPTIONAL: Host directory (bind-mounted into the api container) where
# encrypted document blobs are stored. Defaults to /data/documents inside
# the container if not overridden.
# DOCUMENT_BLOB_DIR=/data/documents

# ── Authentication ────────────────────────────────────────────────────────────

# REQUIRED: Secret used to sign and verify JWT tokens.
# Must be at least 64 characters. Use a random value in production.
# Generate: openssl rand -hex 64
JWT_SECRET=

# ── AI inference ──────────────────────────────────────────────────────────────

# OPTIONAL: Base URL of the Ollama API, as seen from inside the api container.
# Defaults to http://ollama:11434 (the compose service name).
# Override only when running Ollama outside Docker.
# OLLAMA_BASE_URL=http://ollama:11434

# ── Structured logging (Seq) ──────────────────────────────────────────────────

# OPTIONAL: Seq ingest API key used by Serilog in the api service.
# Create the key in the Seq web UI (http://localhost:5341) after first launch.
# Leave blank to allow unauthenticated ingest (development only).
SEQ_API_KEY=

# ── Observability ─────────────────────────────────────────────────────────────

# REQUIRED: Grafana admin user password.
# The admin username is always "admin".
GRAFANA_ADMIN_PASSWORD=
