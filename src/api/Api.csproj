<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prometheus metrics endpoint — us_003/AC-004 -->
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.*" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
    <!-- Structured logging pipeline — us_004/AC-003, AC-004 -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.*" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="6.*" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="2.*" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="3.*" />
    <!-- PHI field encryption — us_006/AC-001, AC-004; DR-001 (AES-256 PGP symmetric, pgcrypto-compatible) -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.*" />
    <!-- EF Core + PostgreSQL provider + pgvector — us_005/AC-002, AC-003, AC-004 -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.*" />
    <PackageReference Include="EFCore.NamingConventions" Version="8.*" />
    <PackageReference Include="pgvector" Version="0.*" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.2.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- JWT Bearer authentication — us_009/AC-001; TR-005 -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.*" />
    <!-- BCrypt password verification — us_009/AC-005; OWASP A02 constant-time hash comparison -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.*" />
  </ItemGroup>

</Project>
